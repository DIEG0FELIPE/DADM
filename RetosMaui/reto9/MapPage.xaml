<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
             x:Class="reto9.MapPage"
             Title="Lugares cercanos">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Lista" IconImageSource="list.png" Clicked="OnListClicked" />
        <ToolbarItem Text="Ajustes" IconImageSource="settings.png" Clicked="OnSettingsClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Buscar por dirección (alternativa al GPS) -->
        <SearchBar x:Name="AddressSearch"
                   Placeholder="Buscar una dirección o un lugar"
                   SearchButtonPressed="OnAddressSearchPressed" />

        <Grid Grid.Row="1">
            <mapsui:MapControl x:Name="MapView" />

            <!-- Aviso de que se está trabajando (GPS o búsqueda de lugares) -->
            <Border x:Name="BusyBox" IsVisible="False"
                    HorizontalOptions="Center" VerticalOptions="Start" Margin="12"
                    Padding="14,8" StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=#F2FFFFFF, Dark=#F2303030}"
                    StrokeShape="RoundRectangle 18">
                <HorizontalStackLayout Spacing="10">
                    <ActivityIndicator IsRunning="True" HeightRequest="20" WidthRequest="20" />
                    <Label x:Name="BusyLabel" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- Botón flotante: volver a la ubicación actual -->
            <Button x:Name="MyLocationButton"
                    ImageSource="my_location.png"
                    HorizontalOptions="End" VerticalOptions="End" Margin="16"
                    WidthRequest="56" HeightRequest="56" CornerRadius="28" Padding="0"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#303030}"
                    SemanticProperties.Description="Usar mi ubicación actual"
                    Clicked="OnMyLocationClicked" />
        </Grid>

        <!-- Panel inferior: el punto de búsqueda o el lugar seleccionado -->
        <Border Grid.Row="2" Padding="16,12" StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#202020}">

            <Grid>
                <VerticalStackLayout x:Name="OriginPanel" Spacing="2">
                    <Label x:Name="OriginTitle" FontAttributes="Bold" FontSize="16" Text="Buscando su ubicación…" />
                    <Label x:Name="OriginAddress" IsVisible="False" />
                    <Label x:Name="OriginCoordinates" FontSize="12" IsVisible="False"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                    <Label x:Name="ResultsLabel" Margin="0,6,0,0" FontSize="13" IsVisible="False" />
                </VerticalStackLayout>

                <Grid x:Name="PlacePanel" IsVisible="False" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10">
                    <Ellipse x:Name="PlaceColor" WidthRequest="14" HeightRequest="14" VerticalOptions="Start" Margin="0,4,0,0" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label x:Name="PlaceName" FontAttributes="Bold" FontSize="17" />
                        <Label x:Name="PlaceSummary" FontSize="13" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2" Margin="0,6,0,0">
                        <Label x:Name="PlaceAddress" FontSize="13" />
                        <Label x:Name="PlacePhone" FontSize="13" />
                        <Label x:Name="PlaceHours" FontSize="13" />
                        <Label x:Name="PlaceWebsite" FontSize="13" TextDecorations="Underline"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnWebsiteTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </VerticalStackLayout>

                    <HorizontalStackLayout Grid.Row="2" Grid.Column="1" Spacing="10" Margin="0,10,0,0">
                        <Button Text="Cómo llegar" Clicked="OnDirectionsClicked" />
                        <Button Text="Cerrar" Clicked="OnClosePlaceClicked"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    </HorizontalStackLayout>
                </Grid>
            </Grid>
        </Border>
    </Grid>

</ContentPage>
